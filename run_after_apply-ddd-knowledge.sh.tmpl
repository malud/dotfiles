HEADER
echo "$DDD_CLAUDE" >> "$DEST/CLAUDE.md"

# 6. Materialize CLAUDE.md per profile = shared + optional ${profile}/CLAUDE.md.local
for profile in "$HOME/.claude-private" "$HOME/.claude-client"; do
    [[ -d "$profile" ]] || continue
    cp "$DEST/CLAUDE.md" "$profile/CLAUDE.md"
    if [[ -f "$profile/CLAUDE.md.local" ]]; then
        printf '\n---\n\n' >> "$profile/CLAUDE.md"
        cat "$profile/CLAUDE.md.local" >> "$profile/CLAUDE.md"
    fi
done

echo "DDD knowledge base applied"
