{{ if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
set -euo pipefail

if ! command -v herdr &>/dev/null; then
  echo "⚠️  herdr not found, skipping plugin installation"
  exit 0
fi

pi_integration_status="$(herdr integration status 2>/dev/null | grep '^pi:' || true)"
if [[ "$pi_integration_status" == pi:\ current* ]]; then
  echo "✅ Herdr pi integration already current"
elif herdr integration install pi; then
  echo "✅ Herdr pi integration installed"
else
  echo "⚠️  Herdr pi integration failed to install"
fi

installed="$(herdr plugin list --json 2>/dev/null | jq -r '.result.plugins[].plugin_id' || true)"

# A plugin that is already present stays as it is: a `herdr plugin link` to a
# local checkout must not be replaced by a GitHub install.
install_plugin() {
  local id="$1" source="$2"
  shift 2
  if grep -qx "$id" <<<"$installed"; then
    echo "✅ $id already installed"
    return
  fi
  echo "Installing $id from $source..."
  if herdr plugin install -y "$source" "$@"; then
    echo "✅ $id installed"
  else
    echo "⚠️  $id failed to install"
  fi
}

install_plugin persiyanov.reviewr persiyanov/herdr-reviewr

{{ if eq .chezmoi.os "darwin" -}}
# The fork branch carries the Creator Micro 2 fixes until alasano/house-of-herdr
# PRs #4-#7 merge; then drop --ref and install alasano/house-of-herdr/packages/codex-micro.
if command -v npm &>/dev/null; then
  install_plugin alasano.codex-micro malud/house-of-herdr/packages/codex-micro --ref integration/creator-micro-2
  echo "ℹ️  codex-micro needs Input Monitoring for the terminal app (System Settings → Privacy & Security)"
else
  echo "⚠️  npm not found, skipping alasano.codex-micro (Brewfile: node)"
fi
{{ end -}}
{{ end -}}
