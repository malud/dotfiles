#!/usr/bin/env bash
{{ if eq .chezmoi.os "darwin" -}}
set -euo pipefail

if [ -f /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -f /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
else
  echo "❌ Homebrew not found"
  exit 1
fi

brew update
# A single failing formula (e.g. a transient symlink conflict) makes brew bundle
# exit non-zero even though it installed everything else; don't let that abort
# the upgrade/cleanup that follow.
brew bundle --file="${HOME}/.Brewfile" || echo "⚠️  brew bundle reported failures; continuing"
brew upgrade
brew cleanup
{{ else -}}
exit 0
{{ end -}}
